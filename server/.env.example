# Copy this file to .env and fill in real values.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# SMTP settings (Gmail: smtp.gmail.com / 465 / app password)
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# MAIL_FROM must be the mailbox you log in with (SMTP_USER), e.g. info@
MAIL_FROM="Pharma Med University <info@pharmameduniversity.com>"

# Enquiry + Apply forms are delivered here
ADMISSION_EMAIL=registrar@pharmameduniversity.com
# Contact form is delivered here
CONTACT_EMAIL=info@pharmameduniversity.com
