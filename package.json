{
  "name": "pharmameduniversity",
  "private": true,
  "version": "1.0.0",
  "description": "Pharma Med University website (React + Node)",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
